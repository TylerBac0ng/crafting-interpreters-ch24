// 24.4: sqrt() and floor(). Lox has no modulo operator, so mod() is built
// from floor().
fun mod(a, b) {
  return a - b * floor(a / b);
}

fun isPrime(n) {
  if (n < 2) return false;
  var limit = floor(sqrt(n));
  for (var d = 2; d <= limit; d = d + 1) {
    if (mod(n, d) == 0) return false;
  }
  return true;
}

var line = "";
var count = 0;
for (var n = 1; n <= 60; n = n + 1) {
  if (isPrime(n)) {
    line = line + str(n) + " ";
    count = count + 1;
  }
}
print line;
print str(count) + " primes up to 60";

// Integer division and digit sums.
fun digitSum(n) {
  var sum = 0;
  while (n > 0) {
    sum = sum + mod(n, 10);
    n = floor(n / 10);
  }
  return sum;
}
print "digit sum of 98765: " + str(digitSum(98765));
print "hypotenuse of 5, 12: " + str(sqrt(5 * 5 + 12 * 12));
